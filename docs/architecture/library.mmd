erDiagram
    USERS ||--o| BORROWERS : "registers as"
    AUTHORS ||--o{ BOOKS : "writes"
    GENRES ||--o{ BOOKS : "classifies"
    BORROWERS ||--o{ LOANS : "takes"
    BOOKS ||--o{ LOANS : "loaned through"

    USERS {
        int id PK
        string email
        string name
        string password_hash
        string role
        datetime created_at
    }

    BORROWERS {
        int id PK
        int user_id FK "FK -> USERS"
        string card_number
        string phone
        string address
        datetime membership_date
    }

    AUTHORS {
        int id PK
        string name
        string bio
        datetime created_at
    }

    GENRES {
        int id PK
        string name
        string description
    }

    BOOKS {
        int id PK
        int author_id FK "FK -> AUTHORS"
        int genre_id FK "FK -> GENRES"
        string title
        string isbn
        int publication_year
        int total_copies
        int available_copies
    }

    LOANS {
        int id PK
        int book_id FK "FK -> BOOKS"
        int borrower_id FK "FK -> BORROWERS"
        datetime loan_date
        datetime due_date
        datetime return_date
        string status
    }
